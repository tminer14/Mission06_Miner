@{
}

@{
    ViewData["Title"] = "Add Movie";
}

@model Movie

<div class="text-center">

    <!--Put in inputs for the user-->
    <h1>Enter a Movie:</h1>
    <br />

    <form method="post">

		<input type="hidden" asp-for="MovieId"/>

        <label asp-for="Title">Title</label>
        <input asp-for="Title" required/>
        <br /><br />

        <label asp-for="CategoryId">Category</label>
        <select>
            <option value="">Select a Category</option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
        <br /><br />
		<label asp-for="Year">Year</label>
		<input asp-for="Year" type="number" min="1888" required/>
        <br /><br />
		<label asp-for="Director">Director</label>
        <input asp-for="Director"  />
        <br /><br />
		<label asp-for="Rating">Rating</label>
		<select asp-for="Rating">
            <option value="G">G</option>
			<option value="PG">PG</option>
			<option value="PG-13">PG-13</option>
			<option value="R">R</option>
         </select>
        <br /><br />
		<label asp-for="Edited">Edited?</label>
        <div>
            <input type="radio" asp-for="Edited" value="true" id="edited-yes" />
            <label for="edited-yes">Yes</label>

            <input type="radio" asp-for="Edited" value="false" id="edited-no" />
            <label for="edited-no">No</label>
        </div>
        <br />

        <label asp-for="LentTo">Lent To:</label>
        <input asp-for=LentTo />
        <br/><br />
        <label asp-for="CopiedToPlex">Copied to plex?</label>
        <div>
            <input type="radio" asp-for="CopiedToPlex" value="true" id="copied-yes" />
            <label for="copied-yes">Yes</label>

            <input type="radio" asp-for="CopiedToPlex" value="false" id="copied-no" />
            <label for="copied-no">No</label>
        </div>
        <br />
		<label asp-for="Notes">Notes:</label>
		<textarea asp-for="Notes"></textarea>
		<br /><br />

        <button type="submit">Submit</button>
    </form>


 </div>